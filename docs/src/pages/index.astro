---
import '../styles/global.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/700.css';

import Header from '../components/header.astro';
import HeroSection from '../components/marketing/hero.astro';
import AuthenticationSection from '../components/marketing/authentication.astro';
import SovereigntySection from '../components/marketing/sovereignty.astro';
import App from "../components/marketing/app.astro";
const base = import.meta.env.BASE_URL;
export const lang = "en"
---
<html lang="en">

<head>
  <title>Liquid Auth</title>
  <meta name="description" content="Web3 meets real world Authentication"/>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href={`${base}logo-background.svg`} />
  <style is:global>
      html, body {
          height: 100%;
          background: black;
          scroll-behavior: smooth;
      }
      @media (prefers-reduced-motion: reduce) {
          html,body {
              scroll-behavior: auto;
          }
      }
  </style>
</head>
<body>
  <div class="min-h-full">
    <Header />
    <HeroSection />
    <App />
    <AuthenticationSection />
    <SovereigntySection />
  </div>
</body>
</html>