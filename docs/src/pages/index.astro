---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/700.css';

import Header from '../components/header.astro';
import HeroSection from '../components/marketing/hero.astro';
import AuthenticationSection from '../components/marketing/authentication.astro';
import SovereigntySection from '../components/marketing/sovereignty.astro';
import App from "../components/marketing/app.astro";
const base = import.meta.env.BASE_URL;
export const lang = "en"
---
<html lang="en">

<head>
  <title>Liquid Auth</title>
  <meta name="description" content="Web3 meets real world Authentication"/>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href={`${base}logo-background.svg`} />

  <!-- Google Tag Manager -->
  <script is:inline>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MK3HM7BF');
  </script>
  <!-- End Google Tag Manager -->

  <style is:global>
      html, body {
          height: 100%;
          background: black;
          scroll-behavior: smooth;
      }
      @media (prefers-reduced-motion: reduce) {
          html,body {
              scroll-behavior: auto;
          }
      }
  </style>
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript>
    <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MK3HM7BF"
            height="0" width="0" style="display:none;visibility:hidden"></iframe>
  </noscript>
  <!-- End Google Tag Manager (noscript) -->

  <div class="min-h-full">
    <Header />
    <HeroSection />
    <App />
    <AuthenticationSection />
    <SovereigntySection />
  </div>
</body>
</html>