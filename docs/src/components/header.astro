---
import logoDark from '../assets/images/logo_dark.svg';

const name = 'Liquid Auth';
const baseURL = import.meta.env.BASE_URL;
const base = baseURL === '/' ? '.' : baseURL;

const links = [
  {
    title: 'Deep Dive',
    href: `${base}/architecture`
  },
  {
    title: 'Features',
    href: `${base}/introduction`
  },
  {
    title: 'Demo',
    href: '#get-connected'
  }
];

---
<header class="absolute inset-x-0 top-0 z-50">
  <nav class="flex items-center justify-center lg:justify-between p-6 lg:px-16" aria-label="Global">
    <div class="h-16 flex flex-col lg:flex-row lg:flex-1 items-center gap-2">
      <img class="h-12 w-auto" src={logoDark.src} alt="">
    </div>
    <div class="hidden lg:flex lg:flex-1 lg:gap-x-12 items-center lg:justify-end">
      {links.map(({ title,  href }) =>
        <a target="_self" href={href} class="font-poppins text-md leading-6 text-white">{title}</a>
      )}
      <a href={`${base}/guides/getting-started`} class="px-6 py-2 font-poppins uppercase rounded-full leading-6 bg-liquid-purple-contrast text-white">Documentation</a>
    </div>
  </nav>
</header>
